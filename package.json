{
  "name": "browser-github-comment-translator",
  "version": "0.1.4",
  "private": true,
  "description": "Translate a single GitHub issue, pull request or discussion comment in place with Google Translate or your own AI model.",
  "type": "module",
  "scripts": {
    "dev": "wxt -b chrome --mv3",
    "dev:chrome": "wxt -b chrome --mv3",
    "dev:edge": "wxt -b edge --mv3",
    "dev:firefox": "wxt -b firefox --mv3",
    "build": "wxt build -b chrome --mv3",
    "build:chrome": "wxt build -b chrome --mv3",
    "build:edge": "wxt build -b edge --mv3",
    "build:firefox": "wxt build -b firefox --mv3",
    "build:all": "pnpm run clean && pnpm run build:chrome && pnpm run build:edge && pnpm run build:firefox",
    "zip": "wxt zip -b chrome --mv3",
    "zip:chrome": "wxt zip -b chrome --mv3",
    "zip:edge": "wxt zip -b edge --mv3",
    "zip:firefox": "wxt zip -b firefox --mv3",
    "zip:all": "pnpm run clean && pnpm run zip:chrome && pnpm run zip:edge && pnpm run zip:firefox",
    "clean": "rimraf .output",
    "compile": "tsc --noEmit",
    "test": "vitest run",
    "postinstall": "wxt prepare",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check"
  },
  "dependencies": {
    "lucide": "^1.55.0"
  },
  "devDependencies": {
    "@wxt-dev/auto-icons": "^1.1.2",
    "happy-dom": "^21.0.1",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "rimraf": "^6.1.3",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11",
    "wxt": "^0.20.26"
  },
  "packageManager": "pnpm@11.25.0"
}
